@{ Layout = null; }

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #fff;
            font-family: Arial, sans-serif;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0px 0px 20px rgba(0, 0, 0, 0.1);
        }

        .card-header {
            background-color: #000;
            color: #fff;
            border-bottom: none;
            text-align: center;
            padding: 20px 0;
            border-top-left-radius: 15px;
            border-top-right-radius: 15px;
        }

        .card-body {
            padding: 30px;
        }

        .form-control {
            border: 1px solid #ddd;
            border-radius: 5px;
            padding: 10px;
            margin-bottom: 20px;
            box-shadow: none;
        }

            .form-control:focus {
                border-color: #000;
                box-shadow: 0 0 0 0.2rem rgba(0, 0, 0, 0.1);
            }

        .btn {
            background-color: #000;
            border: none;
            border-radius: 20px;
            padding: 10px 25px;
            font-size: 16px;
            font-weight: bold;
            color: #fff;
        }

            .btn:hover {
                background-color: #222;
            }

        .small {
            color: #888;
        }

        .footer-link {
            color: #000;
        }

            .footer-link:hover {
                color: #555;
                text-decoration: none;
            }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5">
                <div class="card shadow-lg">
                    <div class="card-header">
                        <h3 class="font-weight-light my-4">Login</h3>
                    </div>
                    <div class="card-body">
                        <form action="@Url.Action("Index", "Acceso")" method="post">
                            <div class="form-group">
                                <input class="form-control" name="correos" type="email" placeholder="Email" />
                            </div>
                            <div class="form-group">
                                <input class="form-control" name="clave" type="password" placeholder="Contraseña" />
                            </div>
                            @{ if (ViewBag.Error != null)
                                            {
                                <div class="alert alert-danger" role="alert">
                                    @ViewBag.Error
                                </div> } }
                            <div class="d-flex align-items-center justify-content-between mt-4 mb-0">
                                <a class="small footer-link" href="@Url.Action("ReestablecerClave", "Acceso")">¿Has olvidado la contraseña?</a>
                                <button type="submit" class="btn">Iniciar Sesión</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
</body>
</html>